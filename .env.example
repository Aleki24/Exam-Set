# ============================================================================
# SUPABASE
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# The public key. Any ONE of these three names works — whichever your setup
# gives you. The Supabase Vercel integration provisions the ANON_KEY name; the
# Supabase dashboard now shows it as a publishable key.
#
# Getting this name wrong takes down sign-in AND the question bank at once,
# while every page still renders, so check /api/health after deploying: it says
# in one line whether the app can reach the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_key_here
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only. Required to confirm M-Pesa payments: the Daraja callback carries
# no user session, so it needs the service role to settle an order and grant the
# download. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================================
# PAYMENTS — M-PESA (Safaricom Daraja)
# ============================================================================
# Leave these unset to run in manual-confirmation mode: buyers pay to the
# paybill below and submit their transaction code for confirmation.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# Shown to buyers on the checkout page for manual payment.
NEXT_PUBLIC_MPESA_PAYBILL=
NEXT_PUBLIC_MPESA_TILL=
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS=

# ============================================================================
# AI (optional — question extraction from pasted papers)
# ============================================================================
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ============================================================================
# FILE STORAGE — paper and marking-scheme PDFs
#
# Two options. You do not need both.
#
# 1. SUPABASE STORAGE (default, nothing to sign up for)
#    Works as soon as SUPABASE_SERVICE_ROLE_KEY above is set. Run migration
#    014_storage_bucket.sql to create the private bucket. Override the bucket
#    name only if you want something other than "exam-papers".
SUPABASE_STORAGE_BUCKET=exam-papers
#
# 2. CLOUDFLARE R2 (optional; cheaper at scale because egress is free)
#    Set all four and R2 takes over automatically. Leave them blank to stay on
#    Supabase Storage.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ============================================================================
# WHATSAPP BOT (optional)
#
# Lets teachers text for a paper and receive the PDF back. Leave these unset and
# the webhook returns 503 and nothing else in the app changes.
#
# From the Meta app dashboard -> WhatsApp -> API Setup. The number must not
# already be registered on WhatsApp or WhatsApp Business.
#
# WHATSAPP_VERIFY_TOKEN is a string you invent; you paste the same value into
# Meta when configuring the webhook, and it only proves the handshake came from
# whoever set the webhook up.
#
# WHATSAPP_APP_SECRET is what actually protects the endpoint: every delivery is
# signed with it. Without it, anyone who finds the URL can request any paper.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Webhook URL to register with Meta:
#   https://your-domain/api/whatsapp/webhook

# ============================================================================
# APP
# ============================================================================
# Must be the public URL. The M-Pesa callback and the redirect on every emailed
# auth link are built from it, so a wrong value here loses payments and leaves
# confirmation emails pointing at localhost.
#
# Setting it is only half the job: this origin must also be the Site URL, and
# "<origin>/auth/callback" must be in the Redirect URLs list, under
# Authentication → URL Configuration in the Supabase dashboard. Supabase ignores
# a redirect it has not been told to allow and falls back to the Site URL
# without reporting anything. See "Where emailed auth links land" in the README.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
